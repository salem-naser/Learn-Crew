{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medication History API Schema",
  "description": "Schema for submitting medication history to the medication endpoint",
  "type": "object",
  "required": ["user_guid", "medications"],
  "properties": {
    "user_guid": {
      "type": "string",
      "description": "User GUID returned from user creation endpoint",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "medications": {
      "type": "array",
      "description": "Array of medication records with FDA-validated data",
      "items": {
        "type": "object",
        "required": ["medication_id", "name", "start_date"],
        "properties": {
          "medication_id": {
            "type": "string",
            "description": "Unique medication record identifier",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "description": "Brand or trade name of the medication",
            "minLength": 1
          },
          "generic_name": {
            "type": ["string", "null"],
            "description": "Generic/scientific name of the medication"
          },
          "strength": {
            "type": ["string", "null"],
            "description": "Medication strength (e.g., 500 mg, 10 ml)",
            "pattern": "^[0-9]+(\\.[0-9]+)?\\s*(mg|g|ml|mcg|IU|%)$"
          },
          "form": {
            "type": ["string", "null"],
            "description": "Medication form (e.g., Tablet, Capsule, Liquid)",
            "enum": ["Tablet", "Capsule", "Liquid", "Injection", "Cream", "Ointment", "Patch", "Inhaler", "Drop", "Suppository", "Other", null]
          },
          "route": {
            "type": ["string", "null"],
            "description": "Route of administration",
            "enum": ["Oral", "Topical", "Intravenous", "Intramuscular", "Subcutaneous", "Inhalation", "Rectal", "Ophthalmic", "Otic", "Nasal", "Other", null]
          },
          "frequency_raw": {
            "type": ["string", "null"],
            "description": "Original frequency text from prescription"
          },
          "frequency_standard": {
            "type": ["string", "null"],
            "description": "Standardized frequency code",
            "enum": ["QD", "BID", "TID", "QID", "QHS", "PRN", "STAT", "Q4H", "Q6H", "Q8H", "Q12H", "Weekly", "Monthly", null]
          },
          "timing": {
            "type": ["array", "null"],
            "description": "Specific times of day to take medication",
            "items": {
              "type": "string",
              "enum": ["Morning", "Afternoon", "Evening", "Night", "Before Meal", "After Meal", "With Food", "On Empty Stomach"]
            }
          },
          "dosage": {
            "type": ["string", "null"],
            "description": "Dosage amount per administration"
          },
          "duration": {
            "type": ["string", "null"],
            "description": "Duration of treatment (e.g., 7 days, 2 weeks)"
          },
          "indication": {
            "type": ["string", "null"],
            "description": "Reason for prescription or condition being treated"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Date medication was started (YYYY-MM-DD)"
          },
          "end_date": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Date medication was discontinued (YYYY-MM-DD)"
          },
          "prescriber": {
            "type": ["string", "null"],
            "description": "Name of the prescribing physician"
          },
          "prescriber_npi": {
            "type": ["string", "null"],
            "description": "National Provider Identifier of prescriber",
            "pattern": "^[0-9]{10}$"
          },
          "instructions": {
            "type": ["string", "null"],
            "description": "Special instructions for taking the medication"
          },
          "side_effects": {
            "type": ["array", "null"],
            "description": "Reported side effects",
            "items": {
              "type": "string"
            }
          },
          "fda_data": {
            "type": ["object", "null"],
            "description": "Additional data from FDA API",
            "properties": {
              "ndc": {
                "type": ["string", "null"],
                "description": "National Drug Code"
              },
              "manufacturer": {
                "type": ["string", "null"],
                "description": "Manufacturer name"
              },
              "drug_class": {
                "type": ["string", "null"],
                "description": "Pharmacological class"
              },
              "warnings": {
                "type": ["array", "null"],
                "description": "FDA warnings and precautions",
                "items": {
                  "type": "string"
                }
              },
              "interactions": {
                "type": ["array", "null"],
                "description": "Known drug interactions",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "status": {
            "type": ["string", "null"],
            "enum": ["active", "completed", "discontinued", "on_hold", null],
            "description": "Current status of medication"
          },
          "metadata": {
            "type": ["object", "null"],
            "description": "Additional medication metadata",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
